# Copy to backend/.env for local runs (never commit .env).

FLASK_ENV=development
PORT=5000
AWS_REGION=us-east-1

# Optional: load keys from AWS Secrets Manager (JSON object of KEY=value).
# Prefer this in EKS via IRSA + external secrets later — do not bake secrets into images.
# AWS_SECRETS_MANAGER_SECRET_ID=anatomy-chatbot/backend

# Local / non-Secrets-Manager development:
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# DYNAMODB_TABLE_NAME=ChatbotInteractionsMsk3
# DYNAMODB_SESSION_TABLE=ChatbotSessions
# USERS_TABLE=Users
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# OPENAI_API_KEY=
# SESSION_SECRET_KEY=

# Browser origins allowed to call the API (comma-separated).
# CORS_ORIGINS=http://localhost:3000,https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
